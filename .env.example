# URL de connexion Postgres (dans Dokploy : « Internal Connection URL » de la base)
DATABASE_URL=postgres://rimarami:motdepasse@localhost:5432/rimarami
# Facultatif : code demandé pour modifier les scores (la consultation reste libre)
APP_PIN=
# Facultatif : port d'écoute (3000 par défaut)
PORT=3000
# Facultatif : mettre true si la base exige SSL
PGSSL=false
